# Copy to .env and fill values locally. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=smartstore_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-a-model-returned-by-the-model-check-command
# Razorpay test mode. Keep secrets in backend/.env only; never use a live key until deployment review.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ORDER_CURRENCY=INR
ORDER_DELIVERY_CHARGE=0.00
